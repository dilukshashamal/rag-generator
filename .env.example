# Copy to .env. Replace the local database password before deployment.
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PORT=55432
REDIS_PORT=56379
APP_PORT=8501
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://rag:replace-with-a-local-development-password@localhost:55432/rag
REDIS_URL=redis://localhost:56379/0
STORAGE_ROOT=./data/uploads
RESULTS_ROOT=./data/evaluations
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_SAME_PROVIDER_FALLBACK_MODEL=
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_MODEL=llama3.2:3b
LLM_FALLBACK_BASE_URL=http://host.docker.internal:11434
LLM_FALLBACK_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_PASSAGE_TOKENS=180
RERANKER_PASSAGE_OVERLAP=40
RERANKER_MAX_PASSAGES=16
TOKENIZER_ENCODING=cl100k_base
MODEL_DEVICE=cpu
OBSERVABILITY_ENABLED=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
# Consistent native colors for the canvas, sidebar, widgets, menus and charts.
STREAMLIT_THEME_BASE=light
STREAMLIT_THEME_PRIMARY_COLOR="#2563eb"
STREAMLIT_THEME_BACKGROUND_COLOR="#ffffff"
STREAMLIT_THEME_SECONDARY_BACKGROUND_COLOR="#f1f5f9"
STREAMLIT_THEME_TEXT_COLOR="#0f172a"
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=60
MAX_UPLOAD_MB=20
MAX_PAGES=100
MAX_EXTRACTED_CHARACTERS=2000000
CHUNK_TOKENS=600
CHUNK_OVERLAP=100
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RERANK_TOP_K=10
CONTEXT_TOP_K=5
MIN_RERANK_SCORE=0.55
MAX_CONTEXT_TOKENS=3500
MAX_OUTPUT_TOKENS=1200
CHAT_HISTORY_MESSAGES=6
ANSWER_CACHE_TTL=3600
EMBEDDING_CACHE_TTL=604800
CHAT_RATE_LIMIT=20
UPLOAD_RATE_LIMIT=10
RATE_WINDOW_SECONDS=60
EVAL_MAX_QUESTIONS=10
EVAL_DATASET_PATH=./evals/dataset.json
# For the microgrid PDF, use ./evals/microgrid_dataset.json (exactly 10 cases).
# Pacing delay between evaluation queries (in seconds) to stay within free-tier API rate limits
EVAL_REQUEST_DELAY_SECONDS=1.0
EVAL_ENABLE_RAGAS=false
EVAL_LLM_MODEL=
EVAL_LLM_BASE_URL=
EVAL_LLM_API_KEY=
